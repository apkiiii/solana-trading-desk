# ---------------------------------------------------------------------------
# MY SOLANA TRADING DESK — clés API
# 1. Copie ce fichier et renomme la copie en ".env" (dans le même dossier).
# 2. Colle tes clés après le signe "=" (sans espace, sans guillemets).
#
# NE METS JAMAIS ICI : ta clé privée, ta phrase de récupération (seed),
# ni rien qui permette de dépenser tes fonds. Le programme refusera de démarrer
# s'il trouve une variable de ce type. La clé privée du wallet de trading sera
# stockée plus tard dans le Gestionnaire d'identifiants Windows.
# ---------------------------------------------------------------------------

# Obligatoire — https://dashboard.helius.dev (offre gratuite)
HELIUS_API_KEY=

# Recommandé — https://developers.jup.ag (clé gratuite). Sans clé : 0,5 requête/s.
JUPITER_API_KEY=

# Optionnel — https://rugcheck.xyz (la lecture des rapports fonctionne sans clé)
RUGCHECK_API_KEY=

# Optionnel — un autre fournisseur RPC à la place de Helius (laisser vide sinon)
SOLANA_RPC_URL=
SOLANA_WS_URL=
